# Copy to test/qa/.env (gitignored): `npm run qa:up` does it for you and generates the passwords.
# PostgreSQL image tag, pinned to a release of the latest stable major (18); override to try another version.
POSTGRES_VERSION=18.6
POSTGRES_PORT=54329
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=

# MariaDB image tag, pinned to a release of the latest LTS (11.8); override to try another version.
MARIADB_VERSION=11.8.9
MARIADB_PORT=33306
MARIADB_DATABASE=shop
MARIADB_USER=shop
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
