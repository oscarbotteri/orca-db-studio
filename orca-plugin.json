{
  "manifestVersion": 2,
  "id": "db-studio",
  "name": "DB Studio",
  "version": "0.1.0",
  "description": "Browse and query PostgreSQL, MySQL/MariaDB and SQLite from Orca. Reads each worktree's .env to offer its database.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/index.ts",
  "contributes": {
    "panels": [
      {
        "id": "db-studio",
        "title": "DB Studio",
        "icon": "database",
        "entry": "src/panel/index.tsx",
        "ui": "components"
      }
    ],
    "customEditors": [
      {
        "id": "db-studio-query",
        "title": "DB Studio",
        "extensions": [".sql"],
        "entry": "src/editor/index.ts",
        "frame": "isolated"
      }
    ],
    "commands": [
      {
        "id": "db-studio.openSqliteFile",
        "title": "DB Studio: Open SQLite File",
        "when": "global"
      }
    ],
    "settings": [
      {
        "key": "envVariable",
        "title": "Connection variable",
        "description": "Variable read from the worktree's .env to offer a per-worktree connection.",
        "type": "string",
        "default": "DATABASE_URL"
      },
      {
        "key": "queryTimeoutSeconds",
        "title": "Query timeout (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 1,
        "maximum": 110
      },
      {
        "key": "rowLimit",
        "title": "Row limit",
        "description": "Rows shown for a query without its own LIMIT. Results never exceed 5000 rows or about 900 KB.",
        "type": "integer",
        "default": 100,
        "minimum": 1
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    }
  ]
}
